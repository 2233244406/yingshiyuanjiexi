name: 构建 Windows x64 绿色文件夹版

on:
  workflow_dispatch:
  push:
    tags:
      - "site-list-v*"

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest
    steps:
      - name: 获取源代码
        uses: actions/checkout@v4

      - name: 设置 Python 3.12 x64
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          architecture: "x64"

      - name: 安装打包依赖
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements-build.txt

      - name: 编译 Windows 文件夹版 EXE
        shell: pwsh
        run: pyinstaller --clean --noconfirm 启动站点列表.spec

      - name: Windows EXE 实际启动冒烟测试
        shell: pwsh
        run: ./tests/smoke-test.ps1 -OutputDirectory "dist/WebHomeTV-站点列表"

      - name: 组装并检查绿色版目录
        shell: pwsh
        run: |
          $out = "dist/WebHomeTV-站点列表"
          if (!(Test-Path "$out/启动站点列表.exe")) { throw "未生成启动站点列表.exe" }
          if (!(Test-Path "$out/_internal/site_list.html")) { throw "缺少网页资源 site_list.html" }
          Copy-Item "启动站点列表.bat" $out
          Copy-Item "停止站点列表.bat" $out
          Copy-Item "README-绿色版.txt" "$out/README.txt"
          New-Item -ItemType Directory -Force "$out/data" | Out-Null
          Compress-Archive -Path $out -DestinationPath "WebHomeTV-站点列表-Windows-x64-绿色版.zip" -Force

      - name: 上传 Windows 绿色版
        uses: actions/upload-artifact@v4
        with:
          name: WebHomeTV-站点列表-Windows-x64-绿色版
          path: WebHomeTV-站点列表-Windows-x64-绿色版.zip
          if-no-files-found: error
